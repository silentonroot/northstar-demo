# Copy to .env for local overrides. This file holds no secrets: Northstar has no
# configuration secrets, and account passwords are generated by `pnpm run seed`.

# Address and port the server listens on.
NORTHSTAR_HOST=127.0.0.1
NORTHSTAR_PORT=4100

# SQLite database file. Created on first start.
NORTHSTAR_DB_PATH=./var/northstar.sqlite

# Absolute session lifetime in seconds.
NORTHSTAR_SESSION_TTL_SECONDS=3600

# Set to true when serving over HTTPS so the session cookie is marked Secure.
NORTHSTAR_COOKIE_SECURE=false

# Log level: fatal, error, warn, info, debug, trace or silent.
NORTHSTAR_LOG_LEVEL=info
